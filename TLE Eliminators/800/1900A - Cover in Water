#include <bits/stdc++.h>
using namespace std;

// 1. Optimization & Fast I/O
void fast_io() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
}

// 2. Common Type Aliases
using ll = long long;
using pii = pair<int, int>;
using pll = pair<ll, ll>;
using vi = vector<int>;
using vll = vector<ll>;

// 3. Constants
const int INF = 1e9 + 7;
const ll LINF = 1e18;
const int MOD = 1e9 + 7;

// 4. Test Case Solver
void solve() {
	int n;
	string s;
	cin >> n;
	cin >> s;
	int count = 0;
	bool flag = false;
	for(int i=0;i<n;i++)
	{
		if(s[i] == '.' && i+1<n && s[i+1] == '.' && i+2<n && s[i+2] == '.')
		{
			flag = true;
			break;
		}
		if(s[i] == '.') count++;
	}
	if(flag) cout<<2<<'\n';
	else cout<<count<<'\n';
}

int main() {
    fast_io();
    
    int t = 1;
    cin >> t; // Comment out if single test case
    while (t--) {
        solve();
    }
    return 0;
}