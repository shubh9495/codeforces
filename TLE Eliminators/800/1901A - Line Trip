#include <bits/stdc++.h>
using namespace std;

// 1. Optimization & Fast I/O
void fast_io() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
}

// 2. Common Type Aliases
using ll = long long;
using pii = pair<int, int>;
using pll = pair<ll, ll>;
using vi = vector<int>;
using vll = vector<ll>;

// 3. Constants
const int INF = 1e9 + 7;
const ll LINF = 1e18;
const int MOD = 1e9 + 7;

// 4. Test Case Solver
void solve() {
	int n,x;
	cin>>n>>x;
	int ans = INT_MIN;
	int prev = 0;
	for(int i=0;i<n;i++)
	{
		int curr;
		cin >> curr;
		ans = max(ans , curr - prev);
		prev = curr;
	}
	ans = max(ans , 2 * (x-prev));
	cout<<ans<<'\n';
}

int main() {
    fast_io();
    
    int t = 1;
    cin >> t; // Comment out if single test case
    while (t--) {
        solve();
    }
    return 0;
}