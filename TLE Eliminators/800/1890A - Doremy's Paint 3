using vll = vector<ll>;

// 3. Constants
const int INF = 1e9 + 7;
const ll LINF = 1e18;
const int MOD = 1e9 + 7;

// 4. Test Case Solver
void solve() {
	int n;
    cin >> n;
    unordered_map<int,int> mp;
    for(int i=0;i<n;i++)
    {
    	int num;
    	cin >> num;
    	mp[num]++;
    }
    if(mp.size() >= 3) cout<<"NO\n";
    else
    {
    	auto it = mp.begin();
    	auto [key1, first] = *it;
    	auto [key2, second] = *(++it);
    	if(first == second || abs(first - second) == 1)
    	{
    		cout<<"YES\n";
    	}	
    	else
    	{
    		cout<<"NO\n";
    	}
    }
}

int main() {
    fast_io();
    
    int t = 1;
    cin >> t; // Comment out if single test case
    while (t--) {
        solve();
    }
    return 0;
}